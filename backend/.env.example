# Copy to .env and adjust. On a live server set DJANGO_DEBUG=false.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Domains this backend answers to, comma separated (e.g. api.healtheworldministries.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The website address(es) staff sign in from, e.g. https://www.healtheworldministries.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Only needed if a browser calls the API from another domain
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Event times are shown in this time zone
DJANGO_TIME_ZONE=Africa/Harare
# How many web servers in front of Django add the visitor's address to X-Forwarded-For
# (1 behind Caddy/nginx on the same server; usually 2 for Vercel + Render). See README.
DJANGO_PROXY_COUNT=1
# Staff are signed out after this many seconds without activity (default 4 hours)
DJANGO_SESSION_SECONDS=14400

# ---- Online giving (see "Online giving" in the README) ----
# PayPal and cards: Client ID and Secret from developer.paypal.com > Apps & Credentials.
# Use sandbox keys with PAYPAL_MODE=sandbox to test, then live keys with PAYPAL_MODE=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Mobile money (EcoCash, InnBucks, O'mari, OneMoney) through Paynow: the integration ID and key
# Paynow gives you, and the email you sign in to Paynow with.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
# The public website address. Paynow sends payment updates to SITE_URL/api/payments/paynow/result,
# so it must be reachable from the internet, e.g. https://www.healtheworldministries.com
SITE_URL=
