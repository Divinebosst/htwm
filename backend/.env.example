# Copy to .env and adjust. On a live server set DJANGO_DEBUG=false.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Domains this backend answers to, comma separated (e.g. api.healtheworldministries.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for the admin login over https, e.g. https://api.healtheworldministries.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Only needed if a browser calls the API from another domain
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Event times are shown in this time zone
DJANGO_TIME_ZONE=Africa/Harare
